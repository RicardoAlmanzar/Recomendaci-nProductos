# ── Base de datos ──────────────────────────────────────────────────────────
SUPABASE_DATABASE_URL=
SUPABASE_POOLER_URL=

# ── Módulo 11: API de Recomendaciones ─────────────────────────────────────
# TTL del cache en memoria (segundos). Default: 300
CACHE_TTL_SECONDS=

# Versión del algoritmo reportada en cada response. Default: rules_v1
ALGO_VERSION=

# ── Módulo 4: Autenticación administrativa ────────────────────────────────
JWT_SECRET=
JWT_EXPIRE_MINUTES=
# true desactiva auth en rutas /admin (solo desarrollo)
ADMIN_AUTH_DISABLED=
